STORE_CORS=http://localhost:8000,http://127.0.0.1:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,http://127.0.0.1:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://127.0.0.1:9000,http://localhost:8000,http://127.0.0.1:8000,https://docs.medusajs.com
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Session pooler (port 5432). Do not use Direct or Transaction pooler :6543.
# Replace PROJECT_REF and the password, then keep ?sslmode=no-verify.
DATABASE_URL=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=no-verify
